<?xml version="1.0" encoding="UTF-8"?>
<map version="1.10" tiledversion="1.10.2" orientation="orthogonal" renderorder="right-down" width="12" height="10" tilewidth="16" tileheight="16" infinite="0" nextlayerid="4" nextobjectid="3">
  <!--
    EXAMPLE TMX FILE - Shows how TMX separates:
    1. TILESETS (graphics/sprite references)
    2. LAYERS (which tiles are placed where)
  -->
  
  <!-- ============================================ -->
  <!-- TILESETS SECTION (GRAPHICS REFERENCES) -->
  <!-- This tells us WHAT images to use as tiles -->
  <!-- ============================================ -->
  <tileset firstgid="1" name="terrain" tilewidth="16" tileheight="16" tilecount="16" columns="4">
    <image source="assets/terrain.png" width="64" height="64"/>
  </tileset>
  
  <tileset firstgid="17" name="objects" tilewidth="16" tileheight="16" tilecount="8" columns="4">
    <image source="assets/objects.png" width="64" height="32"/>
  </tileset>
  
  <!-- ============================================ -->
  <!-- LAYERS SECTION (MAP DATA) -->
  <!-- This tells us WHICH tiles go WHERE -->
  <!-- ============================================ -->
  
