{
  "name": "RetroStudio Lua Extensions",
  "version": "1.0.0",
  "description": "Lua extension library for RetroStudio game development",
  "target_platforms": ["javascript", "cpp"],
  "categories": [
    {
      "name": "UI",
      "description": "User interface and dialog functions",
      "functions": []
    },
    {
      "name": "Sprite",
      "description": "Sprite creation, animation, and transform functions",
      "functions": [
        {
          "name": "Create",
          "description": "Create a sprite instance by name (loads .d2s/.d2f from build)",
          "parameters": [
            {"name": "name", "type": "string", "description": "Sprite asset name (matches d2s_header_t.name)"}
          ],
          "returns": {"type": "string", "description": "The sprite name (handle for all other calls)"},
          "example": "local hero = Sprite.Create(\"hero\")"
        },
        {
          "name": "Destroy",
          "description": "Remove a sprite from the scene",
          "parameters": [
            {"name": "name", "type": "string", "description": "Sprite name"}
          ],
          "example": "Sprite.Destroy(\"hero\")"
        },
        {
          "name": "Clone",
          "description": "Deep-clone a sprite instance under a new name",
          "parameters": [
            {"name": "name", "type": "string", "description": "Source sprite name"},
            {"name": "newName", "type": "string", "description": "New sprite name"}
          ],
          "returns": {"type": "string", "description": "The new sprite name"},
          "example": "Sprite.Clone(\"hero\", \"hero2\")"
        },
        {
          "name": "SetPosition",
          "description": "Set sprite position",
          "parameters": [
            {"name": "name", "type": "string", "description": "Sprite name"},
            {"name": "x", "type": "int32", "description": "X position"},
            {"name": "y", "type": "int32", "description": "Y position"}
          ],
          "example": "Sprite.SetPosition(\"hero\", 100, 200)"
        },
        {
          "name": "GetPosition",
          "description": "Get sprite position",
          "parameters": [
            {"name": "name", "type": "string", "description": "Sprite name"}
          ],
          "returns": {"type": "int32, int32", "description": "X and Y position"},
          "example": "local x, y = Sprite.GetPosition(\"hero\")"
        },
        {
          "name": "SetPositionX",
          "description": "Set sprite X position",
          "parameters": [
            {"name": "name", "type": "string", "description": "Sprite name"},
            {"name": "x", "type": "int32", "description": "X position"}
          ],
          "example": "Sprite.SetPositionX(\"hero\", 100)"
        },
        {
          "name": "GetPositionX",
          "description": "Get sprite X position",
          "parameters": [
            {"name": "name", "type": "string", "description": "Sprite name"}
          ],
          "returns": {"type": "int32", "description": "X position"},
          "example": "local x = Sprite.GetPositionX(\"hero\")"
        },
        {
          "name": "SetPositionY",
          "description": "Set sprite Y position",
          "parameters": [
            {"name": "name", "type": "string", "description": "Sprite name"},
            {"name": "y", "type": "int32", "description": "Y position"}
          ],
          "example": "Sprite.SetPositionY(\"hero\", 200)"
        },
        {
          "name": "GetPositionY",
          "description": "Get sprite Y position",
          "parameters": [
            {"name": "name", "type": "string", "description": "Sprite name"}
          ],
          "returns": {"type": "int32", "description": "Y position"},
          "example": "local y = Sprite.GetPositionY(\"hero\")"
        },
        {
          "name": "SetCenter",
          "description": "Set sprite center of rotation",
          "parameters": [
            {"name": "name", "type": "string", "description": "Sprite name"},
            {"name": "centerX", "type": "int32", "description": "Center X"},
            {"name": "centerY", "type": "int32", "description": "Center Y"}
          ],
          "example": "Sprite.SetCenter(\"hero\", 8, 16)"
        },
        {
          "name": "GetCenter",
          "description": "Get sprite center of rotation",
          "parameters": [
            {"name": "name", "type": "string", "description": "Sprite name"}
          ],
          "returns": {"type": "int32, int32", "description": "Center X and Y"},
          "example": "local cx, cy = Sprite.GetCenter(\"hero\")"
        },
        {
          "name": "SetSize",
          "description": "Set sprite display size",
          "parameters": [
            {"name": "name", "type": "string", "description": "Sprite name"},
            {"name": "width", "type": "int32", "description": "Width"},
            {"name": "height", "type": "int32", "description": "Height"}
          ],
          "example": "Sprite.SetSize(\"hero\", 32, 32)"
        },
        {
          "name": "GetSize",
          "description": "Get sprite display size",
          "parameters": [
            {"name": "name", "type": "string", "description": "Sprite name"}
          ],
          "returns": {"type": "int32, int32", "description": "Width and height"},
          "example": "local w, h = Sprite.GetSize(\"hero\")"
        },
        {
          "name": "SetRotation",
          "description": "Set sprite rotation in degrees",
          "parameters": [
            {"name": "name", "type": "string", "description": "Sprite name"},
            {"name": "angle", "type": "int32", "description": "Rotation angle in degrees"}
          ],
          "example": "Sprite.SetRotation(\"hero\", 45)"
        },
        {
          "name": "GetRotation",
          "description": "Get sprite rotation in degrees",
          "parameters": [
            {"name": "name", "type": "string", "description": "Sprite name"}
          ],
          "returns": {"type": "int32", "description": "Rotation in degrees"},
          "example": "local angle = Sprite.GetRotation(\"hero\")"
        },
        {
          "name": "SetScale",
          "description": "Set sprite scale",
          "parameters": [
            {"name": "name", "type": "string", "description": "Sprite name"},
            {"name": "scaleX", "type": "float", "description": "Horizontal scale"},
            {"name": "scaleY", "type": "float", "description": "Vertical scale"}
          ],
          "example": "Sprite.SetScale(\"hero\", 2.0, 2.0)"
        },
        {
          "name": "GetScale",
          "description": "Get sprite scale",
          "parameters": [
            {"name": "name", "type": "string", "description": "Sprite name"}
          ],
          "returns": {"type": "float, float", "description": "Horizontal and vertical scale"},
          "example": "local sx, sy = Sprite.GetScale(\"hero\")"
        },
        {
          "name": "SetColor",
          "description": "Set sprite tint color (0x00RRGGBB)",
          "parameters": [
            {"name": "name", "type": "string", "description": "Sprite name"},
            {"name": "color", "type": "int32", "description": "Color value (0x00RRGGBB)"}
          ],
          "example": "Sprite.SetColor(\"hero\", 0x00FF0000)"
        },
        {
          "name": "GetColor",
          "description": "Get sprite tint color",
          "parameters": [
            {"name": "name", "type": "string", "description": "Sprite name"}
          ],
          "returns": {"type": "int32", "description": "Color value"},
          "example": "local color = Sprite.GetColor(\"hero\")"
        },
        {
          "name": "SetPaletteSlot",
          "description": "Set which palette slot this sprite uses",
          "parameters": [
            {"name": "name", "type": "string", "description": "Sprite name"},
            {"name": "slot", "type": "int32", "description": "Palette slot index (0-7)"}
          ],
          "example": "Sprite.SetPaletteSlot(\"hero\", 1)"
        },
        {
          "name": "GetPaletteSlot",
          "description": "Get sprite palette slot",
          "parameters": [
            {"name": "name", "type": "string", "description": "Sprite name"}
          ],
          "returns": {"type": "int32", "description": "Palette slot index"},
          "example": "local slot = Sprite.GetPaletteSlot(\"hero\")"
        },
        {
          "name": "SetVisible",
          "description": "Set sprite visibility",
          "parameters": [
            {"name": "name", "type": "string", "description": "Sprite name"},
            {"name": "visible", "type": "boolean", "description": "Visibility state"}
          ],
          "example": "Sprite.SetVisible(\"hero\", false)"
        },
        {
          "name": "GetVisible",
          "description": "Get sprite visibility",
          "parameters": [
            {"name": "name", "type": "string", "description": "Sprite name"}
          ],
          "returns": {"type": "boolean", "description": "Visibility state"},
          "example": "local vis = Sprite.GetVisible(\"hero\")"
        },
        {
          "name": "SetAttributes",
          "description": "Set sprite attribute flags (mirror, repeat, etc.)",
          "parameters": [
            {"name": "name", "type": "string", "description": "Sprite name"},
            {"name": "attributes", "type": "int32", "description": "Attribute flags bitmask"}
          ],
          "example": "Sprite.SetAttributes(\"hero\", 0x08)"
        },
        {
          "name": "GetAttributes",
          "description": "Get sprite attribute flags",
          "parameters": [
            {"name": "name", "type": "string", "description": "Sprite name"}
          ],
          "returns": {"type": "int32", "description": "Attribute flags bitmask"},
          "example": "local attr = Sprite.GetAttributes(\"hero\")"
        },
        {
          "name": "SetAnimation",
          "description": "Set the active animation by name (does not auto-play)",
          "parameters": [
            {"name": "name", "type": "string", "description": "Sprite name"},
            {"name": "animName", "type": "string", "description": "Animation name (e.g. \"idle\", \"run\")"}
          ],
          "example": "Sprite.SetAnimation(\"hero\", \"run\")"
        },
        {
          "name": "Play",
          "description": "Start native auto-animation (ticked by engine, no Lua calls needed per frame)",
          "parameters": [
            {"name": "name", "type": "string", "description": "Sprite name"},
            {"name": "animName", "type": "string", "description": "Animation name (optional, uses current if omitted)"}
          ],
          "example": "Sprite.Play(\"hero\", \"run\")"
        },
        {
          "name": "Stop",
          "description": "Stop native auto-animation (freeze on current frame)",
          "parameters": [
            {"name": "name", "type": "string", "description": "Sprite name"}
          ],
          "example": "Sprite.Stop(\"hero\")"
        },
        {
          "name": "UpdateAnimation",
          "description": "Manual animation tick (for frame-level control from Lua)",
          "parameters": [
            {"name": "name", "type": "string", "description": "Sprite name"},
            {"name": "deltaTime", "type": "float", "description": "Time elapsed in seconds"}
          ],
          "example": "Sprite.UpdateAnimation(\"hero\", dt)"
        }
      ]
    },
    {
      "name": "Music",
      "description": "Background music playback functions", 
      "functions": [
        {
          "name": "Play",
          "description": "Play background music (MOD files)",
          "parameters": [
            {"name": "resourceId", "type": "string", "description": "Resource ID (use MUSIC constants like MUSIC.SONG_1)"},
            {"name": "volume", "type": "float", "description": "Volume level (0.0 to 1.0, optional, default: 1.0)"},
            {"name": "loop", "type": "boolean", "description": "Whether to loop the music (optional, default: true)"}
          ],
          "returns": {"type": "boolean", "description": "True if music started playing successfully"},
          "example": "Music.Play(MUSIC.SONG_1, 0.8, true)"
        },
        {
          "name": "Stop",
          "description": "Stop playing background music",
          "parameters": [
            {"name": "resourceId", "type": "string", "description": "Resource ID to stop"}
          ],
          "returns": {"type": "boolean", "description": "True if music was stopped successfully"},
          "example": "Music.Stop(MUSIC.SONG_1)"
        }
      ]
    },
    {
      "name": "Audio",
      "description": "Audio playback and sound functions", 
      "functions": []
    },
    {
      "name": "SFX",
      "description": "Sound effects playback functions",
      "functions": [
        {
          "name": "Play",
          "description": "Play a sound effect resource",
          "parameters": [
            {"name": "resourceId", "type": "string", "description": "Resource ID (use SFX constants like SFX.COOL)"},
            {"name": "shouldRepeat", "type": "boolean", "description": "Whether to loop the sound (optional)"}
          ],
          "returns": {"type": "boolean", "description": "True if sound started playing successfully"},
          "example": "SFX.Play(SFX.COOL, false)"
        },
        {
          "name": "Stop",
          "description": "Stop a playing sound effect",
          "parameters": [
            {"name": "resourceId", "type": "string", "description": "Resource ID to stop"}
          ],
          "returns": {"type": "boolean", "description": "True if sound was stopped successfully"},
          "example": "SFX.Stop(SFX.COOL)"
        },
        {
          "name": "IsPlaying",
          "description": "Check if a sound effect is currently playing",
          "parameters": [
            {"name": "resourceId", "type": "string", "description": "Resource ID to check"}
          ],
          "returns": {"type": "boolean", "description": "True if sound is currently playing"},
          "example": "SFX.IsPlaying(SFX.COOL)"
        },
        {
          "name": "SetVolume",
          "description": "Set volume for a sound effect resource",
          "parameters": [
            {"name": "resourceId", "type": "string", "description": "Resource ID"},
            {"name": "volume", "type": "float", "description": "Volume level (0.0 to 1.0)"}
          ],
          "returns": {"type": "boolean", "description": "True if volume was set successfully"},
          "example": "SFX.SetVolume(SFX.COOL, 0.8)"
        },
        {
          "name": "List",
          "description": "List all available SFX resources (for debugging)",
          "parameters": [],
          "returns": {"type": "int32", "description": "Number of available resources"},
          "example": "SFX.List()"
        }
      ]
    },
    {
      "name": "Input",
      "description": "Keyboard and mouse input functions",
      "functions": [
        {
          "name": "GetKeysHeld",
          "description": "Returns a bit array of keys currently held",
          "parameters": [],
          "returns": {"type": "uint16", "description": "Bit array of currently held keys"},
          "example": "Input.GetKeysHeld()"
        },
        {
          "name": "GetKeysPressed", 
          "description": "Returns the keys pressed since last update",
          "parameters": [],
          "returns": {"type": "uint16", "description": "Bit array of keys pressed this frame"},
          "example": "Input.GetKeysPressed()"
        },
        {
          "name": "GetKeysReleased",
          "description": "Returns the keys released since last update", 
          "parameters": [],
          "returns": {"type": "uint16", "description": "Bit array of keys released this frame"},
          "example": "Input.GetKeysReleased()"
        },
        {
          "name": "IsKeyHeld",
          "description": "Returns true if the key is held",
          "parameters": [
            {"name": "key", "type": "uint16", "description": "Button mask (use Input.Buttons.* constants)"}
          ],
          "returns": {"type": "boolean", "description": "True if key is currently held"},
          "example": "Input.IsKeyHeld(Input.Buttons.A)"
        },
        {
          "name": "IsKeyPressed",
          "description": "Returns true if the key was pressed this frame",
          "parameters": [
            {"name": "key", "type": "uint16", "description": "Button mask (use Input.Buttons.* constants)"}
          ],
          "returns": {"type": "boolean", "description": "True if key was pressed this frame"},
          "example": "Input.IsKeyPressed(Input.Buttons.A)"
        },
        {
          "name": "IsKeyReleased",
          "description": "Returns true if the key was released this frame",
          "parameters": [
            {"name": "key", "type": "uint16", "description": "Button mask (use Input.Buttons.* constants)"}
          ],
          "returns": {"type": "boolean", "description": "True if key was released this frame"},
          "example": "Input.IsKeyReleased(Input.Buttons.A)"
        }
      ]
    },
    {
      "name": "Math",
      "description": "Mathematical utility functions",
      "functions": [
        {
          "name": "Sin",
          "description": "Sine function",
          "parameters": [{"name": "x", "type": "float", "description": "Angle in radians"}],
          "returns": {"type": "float", "description": "Sine of x"},
          "example": "Math.Sin(1.57)"
        },
        {
          "name": "Cos",
          "description": "Cosine function",
          "parameters": [{"name": "x", "type": "float", "description": "Angle in radians"}],
          "returns": {"type": "float", "description": "Cosine of x"},
          "example": "Math.Cos(0)"
        },
        {
          "name": "Sqrt",
          "description": "Square root function",
          "parameters": [{"name": "x", "type": "float", "description": "Number to take square root of"}],
          "returns": {"type": "float", "description": "Square root of x"},
          "example": "Math.Sqrt(16)"
        },
        {
          "name": "Pow",
          "description": "Power function - raise x to the power of y",
          "parameters": [
            {"name": "x", "type": "float", "description": "Base number"},
            {"name": "y", "type": "float", "description": "Exponent"}
          ],
          "returns": {"type": "float", "description": "x raised to the power of y"},
          "example": "Math.Pow(2, 3)"
        },
        {
          "name": "Atan2",
          "description": "Two-argument arctangent function",
          "parameters": [
            {"name": "y", "type": "float", "description": "Y coordinate"},
            {"name": "x", "type": "float", "description": "X coordinate"}
          ],
          "returns": {"type": "float", "description": "Angle in radians"},
          "example": "Math.Atan2(1, 1)"
        },
        {
          "name": "Min",
          "description": "Returns the minimum of two values",
          "parameters": [
            {"name": "x", "type": "float", "description": "First value"},
            {"name": "y", "type": "float", "description": "Second value"}
          ],
          "returns": {"type": "float", "description": "Minimum value"},
          "example": "Math.Min(5, 10)"
        },
        {
          "name": "Max",
          "description": "Returns the maximum of two values",
          "parameters": [
            {"name": "x", "type": "float", "description": "First value"},
            {"name": "y", "type": "float", "description": "Second value"}
          ],
          "returns": {"type": "float", "description": "Maximum value"},
          "example": "Math.Max(5, 10)"
        },
        {
          "name": "Clamp",
          "description": "Clamps x to min and max inclusive",
          "parameters": [
            {"name": "x", "type": "float", "description": "Value to clamp"},
            {"name": "min", "type": "float", "description": "Minimum value"},
            {"name": "max", "type": "float", "description": "Maximum value"}
          ],
          "returns": {"type": "float", "description": "Clamped value"},
          "example": "Math.Clamp(15, 0, 10)"
        },
        {
          "name": "Ceil",
          "description": "Rounds up to nearest integer",
          "parameters": [{"name": "x", "type": "float", "description": "Value to round up"}],
          "returns": {"type": "float", "description": "Rounded up value"},
          "example": "Math.Ceil(3.2)"
        },
        {
          "name": "Floor",
          "description": "Rounds down to nearest integer",
          "parameters": [{"name": "x", "type": "float", "description": "Value to round down"}],
          "returns": {"type": "float", "description": "Rounded down value"},
          "example": "Math.Floor(3.8)"
        },
        {
          "name": "Round",
          "description": "Rounds to nearest integer",
          "parameters": [{"name": "x", "type": "float", "description": "Value to round"}],
          "returns": {"type": "float", "description": "Rounded value"},
          "example": "Math.Round(3.5)"
        },
        {
          "name": "Abs",
          "description": "Absolute value",
          "parameters": [{"name": "x", "type": "float", "description": "Value to get absolute value of"}],
          "returns": {"type": "float", "description": "Absolute value"},
          "example": "Math.Abs(-5)"
        },
        {
          "name": "And",
          "description": "Binary AND operation",
          "parameters": [
            {"name": "x", "type": "int32", "description": "First integer"},
            {"name": "y", "type": "int32", "description": "Second integer"}
          ],
          "returns": {"type": "int32", "description": "Bitwise AND result"},
          "example": "Math.And(5, 3)"
        },
        {
          "name": "Not",
          "description": "Binary NOT operation",
          "parameters": [{"name": "x", "type": "int32", "description": "Integer to invert"}],
          "returns": {"type": "int32", "description": "Bitwise NOT result"},
          "example": "Math.Not(5)"
        },
        {
          "name": "Or",
          "description": "Binary OR operation",
          "parameters": [
            {"name": "x", "type": "int32", "description": "First integer"},
            {"name": "y", "type": "int32", "description": "Second integer"}
          ],
          "returns": {"type": "int32", "description": "Bitwise OR result"},
          "example": "Math.Or(5, 3)"
        },
        {
          "name": "Xor",
          "description": "Binary XOR operation",
          "parameters": [
            {"name": "x", "type": "int32", "description": "First integer"},
            {"name": "y", "type": "int32", "description": "Second integer"}
          ],
          "returns": {"type": "int32", "description": "Bitwise XOR result"},
          "example": "Math.Xor(5, 3)"
        },
        {
          "name": "LShift",
          "description": "Left shift operation",
          "parameters": [
            {"name": "x", "type": "int32", "description": "Value to shift"},
            {"name": "y", "type": "int32", "description": "Number of bits to shift"}
          ],
          "returns": {"type": "int32", "description": "Left shifted result"},
          "example": "Math.LShift(5, 2)"
        },
        {
          "name": "RShift",
          "description": "Right shift operation",
          "parameters": [
            {"name": "x", "type": "int32", "description": "Value to shift"},
            {"name": "y", "type": "int32", "description": "Number of bits to shift"}
          ],
          "returns": {"type": "int32", "description": "Right shifted result"},
          "example": "Math.RShift(20, 2)"
        },
        {
          "name": "Random",
          "description": "Random integer between x (inclusive) and y (exclusive)",
          "parameters": [
            {"name": "x", "type": "int32", "description": "Minimum value (inclusive)"},
            {"name": "y", "type": "int32", "description": "Maximum value (exclusive)"}
          ],
          "returns": {"type": "int32", "description": "Random integer"},
          "example": "Math.Random(1, 10)"
        },
        {
          "name": "RadiansToDegrees",
          "description": "Convert radians to degrees",
          "parameters": [{"name": "radians", "type": "float", "description": "Angle in radians"}],
          "returns": {"type": "float", "description": "Angle in degrees"},
          "example": "Math.RadiansToDegrees(3.14159)"
        },
        {
          "name": "DegreesToRadians",
          "description": "Convert degrees to radians",
          "parameters": [{"name": "degrees", "type": "float", "description": "Angle in degrees"}],
          "returns": {"type": "float", "description": "Angle in radians"},
          "example": "Math.DegreesToRadians(180)"
        }
      ]
    },
    {
      "name": "Time",
      "description": "Time and date functions",
      "functions": [
        {
          "name": "HoursToDegrees",
          "description": "Returns the angle corresponding to the current time for positioning a watch hand",
          "parameters": [],
          "returns": {"type": "int32", "description": "Angle in degrees for hour hand"},
          "example": "Time.HoursToDegrees()"
        },
        {
          "name": "MinutesToDegrees",
          "description": "Returns the angle corresponding to the current minutes for positioning a watch hand",
          "parameters": [],
          "returns": {"type": "int32", "description": "Angle in degrees for minute hand"},
          "example": "Time.MinutesToDegrees()"
        },
        {
          "name": "SecondsToDegrees",
          "description": "Returns the angle corresponding to the current seconds for positioning a watch hand",
          "parameters": [],
          "returns": {"type": "int32", "description": "Angle in degrees for second hand"},
          "example": "Time.SecondsToDegrees()"
        },
        {
          "name": "Hours",
          "description": "Returns the current hour (24-hour format)",
          "parameters": [],
          "returns": {"type": "int32", "description": "Current hour (0-23)"},
          "example": "Time.Hours()"
        },
        {
          "name": "Minutes",
          "description": "Returns the current minutes",
          "parameters": [],
          "returns": {"type": "int32", "description": "Current minutes (0-59)"},
          "example": "Time.Minutes()"
        },
        {
          "name": "Seconds",
          "description": "Returns the current seconds",
          "parameters": [],
          "returns": {"type": "int32", "description": "Current seconds (0-59)"},
          "example": "Time.Seconds()"
        },
        {
          "name": "Day",
          "description": "Returns the day of the month",
          "parameters": [],
          "returns": {"type": "int32", "description": "Day of month (1-31)"},
          "example": "Time.Day()"
        },
        {
          "name": "Month",
